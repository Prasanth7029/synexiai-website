{
  "name": "synexiai-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://prasanth7029.github.io/synexiai-website",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "kb:generate": "node scripts/generate-site-map.mjs",
    "kb:embed": "node scripts/kb-embed-if-ready.mjs",
    "prebuild": "node scripts/generate-site-map.mjs && node scripts/kb-embed-if-ready.mjs",
    "postbuild": "cp public/sitemap.xml dist/sitemap.xml; [ -f public/robots.txt ] && cp public/robots.txt dist/robots.txt || echo 'robots.txt missing, skipped'",
    "deploy:netlify": "vite build && netlify deploy --dir=dist --functions=netlify/functions --prod",
    "lint": "eslint src --ext .js,.jsx --max-warnings=0",
    "format:check": "prettier -c .",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "typecheck": "tsc -p . --noEmit || echo \"(skip if no TS)\"",
    "preview": "vite preview --port 4173",
    "lighthouse": "lhci autorun || echo \"(optional if LHCI not set)\"",
    "preflight": "npm run lint && npm run format:check && npm run test && npm run build && npm run lighthouse",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.8",
    "aos": "^2.3.4",
    "axios": "^1.10.0",
    "framer-motion": "^12.23.6",
    "front-matter": "^4.0.2",
    "lucide-react": "^0.540.0",
    "nprogress": "^0.2.0",
    "openai": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.35.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.6.3",
    "react-simple-maps": "^3.0.0",
    "react-simple-typewriter": "^5.0.1",
    "react-tooltip": "^5.29.1",
    "react-tsparticles": "^2.12.2",
    "rss-parser": "^3.13.0",
    "styled-components": "^6.1.19",
    "tailwind-scrollbar": "^3.0.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.178.0",
    "tsparticles": "^3.8.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@eslint/js": "^9.30.1",
    "@netlify/plugin-lighthouse": "^3.0.0",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "glob": "^10.4.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "netlify-cli": "^23.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "web-vitals": "^3.5.2"
  },
  "overrides": {
    "esbuild": "0.25.8"
  }
}
